# Dependencies
node_modules/
**/node_modules/

# Environment secrets — never commit
.env
# A password on disk for the Drive bridge. It sits in backend/ rather than in a
# .env file, so the rules above do not catch it.
.drive-bridge-pass
**/.drive-bridge-pass
.env.local
.env.test
.env.production
**/.env
**/.env.local
**/.env.test
**/.env.production

# Build output
dist/
build/
**/dist/
**/build/

# Logs
*.log
logs/
**/logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo

# Uploads / user-generated content
backend/uploads/

# Docker volumes and database backups (never in repo)
postgres_data/
/postgres-data/
/postgres-data-BACKUP/
/backup_before_crm_lead_sync.sql
*.dump
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/
e2e/screenshots/
e2e/.env

# Local operational artefacts — never commit these.
# backups/ holds multi-hundred-MB database dumps and exports/ holds generated
# spreadsheets; both are working files, not source.
backups/
exports/
scratchpad/
*.bak-*

# The owner's verified deposit file: 101 rows of real customer names, banks and
# amounts. This repository is public — the payment scripts read it from disk,
# it is never committed.
backend/scripts/data/
